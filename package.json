{
  "name": "@kevinmarrec/vue-i18n",
  "type": "module",
  "version": "1.1.3",
  "packageManager": "bun@1.3.1",
  "description": "Opinionated Internationalization (i18n) Vue plugin.",
  "author": "Kevin Marrec <kevin@marrec.io>",
  "license": "MIT",
  "homepage": "https://github.com/kevinmarrec/vue-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinmarrec/vue-i18n.git"
  },
  "keywords": [
    "vue",
    "i18n",
    "internationalization",
    "vue",
    "vue-i18n",
    "vue-plugin"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run check:unused && bun run check:eslint && bun run check:types",
    "check:eslint": "eslint . --cache",
    "check:types": "tsc --noEmit",
    "check:unused": "knip -n",
    "lint": "bun run check:eslint",
    "lint:inspect": "bunx @eslint/config-inspector",
    "release": "bumpp",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@kevinmarrec/eslint-config": "^1.5.3",
    "@kevinmarrec/tsconfig": "^1.1.0",
    "@types/bun": "^1.3.1",
    "@vitest/coverage-v8": "^4.0.6",
    "@vue/test-utils": "^2.4.6",
    "bumpp": "^10.3.1",
    "eslint": "^9.39.0",
    "happy-dom": "^20.0.10",
    "knip": "^5.66.4",
    "taze": "^19.9.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
