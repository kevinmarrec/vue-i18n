{
  "name": "@kevinmarrec/vue-i18n",
  "type": "module",
  "version": "1.2.1",
  "packageManager": "bun@1.3.1",
  "description": "Opinionated Internationalization (i18n) Vue plugin.",
  "author": "Kevin Marrec <kevin@marrec.io>",
  "license": "MIT",
  "homepage": "https://github.com/kevinmarrec/vue-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinmarrec/vue-i18n.git"
  },
  "keywords": [
    "vue",
    "i18n",
    "internationalization",
    "vue",
    "vue-i18n",
    "vue-plugin"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run check:unused && bun run check:eslint && bun run check:types",
    "check:eslint": "eslint . --cache",
    "check:types": "tsc --noEmit",
    "check:unused": "knip -n",
    "lint": "bun run check:eslint",
    "lint:inspect": "bunx @eslint/config-inspector",
    "release": "bumpp",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@kevinmarrec/eslint-config": "^1.9.0",
    "@kevinmarrec/tsconfig": "^1.9.0",
    "@types/bun": "^1.3.6",
    "@vitest/coverage-v8": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "happy-dom": "^20.3.1",
    "knip": "^5.81.0",
    "taze": "^19.9.2",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
