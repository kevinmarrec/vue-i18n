{
  "name": "@kevinmarrec/vue-i18n",
  "type": "module",
  "version": "1.6.1",
  "packageManager": "bun@1.3.11",
  "description": "Opinionated Internationalization (i18n) Vue plugin.",
  "author": "Kevin Marrec <kevin@marrec.io>",
  "license": "MIT",
  "homepage": "https://github.com/kevinmarrec/vue-i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinmarrec/vue-i18n.git"
  },
  "keywords": [
    "vue",
    "i18n",
    "internationalization",
    "vue",
    "vue-i18n",
    "vue-plugin"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run knip && bun run typecheck",
    "knip": "knip -n",
    "lint": "eslint . --cache",
    "lint:inspect": "bunx @eslint/config-inspector",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "vite": ">=7.0.0",
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@kevinmarrec/eslint-config": "^1.19.0",
    "@kevinmarrec/tsconfig": "^1.19.0",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "bumpp": "^12.0.0",
    "eslint": "^10.7.0",
    "happy-dom": "^20.11.0",
    "knip": "^6.29.0",
    "taze": "^19.16.0",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
